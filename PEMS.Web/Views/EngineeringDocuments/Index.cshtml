@model List<PEMS.Application.DTOs.EngineeringDocumentDto>

@{
    ViewData["Title"] = "Engineering Documents";
}


<h2>Engineering Documents</h2>


<a asp-action="Create" class="btn btn-success mb-3">
    New Document
</a>


<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Document No</th>
            <th>Title</th>
            <th>Description</th>
            <th>Document Type</th>
            <th>Discipline</th>
            <th>Project</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>


    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.DocumentNo
                </td>


                <td>
                    @item.Title
                </td>


                <td>
                    @item.Description
                </td>


                <td>
                    @item.DocumentType
                </td>
                <td>
                    @item.DisciplineName
                </td>

                <td>
                    @item.ProjectName
                </td>

                <td>
                    @item.CreatedDate.ToShortDateString()
                </td>


                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.DocumentId"
                       class="btn btn-info btn-sm">
                        Details
                    </a>


                    <a asp-action="Edit"
                       asp-route-id="@item.DocumentId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>


                    <form asp-action="Delete"
                          asp-route-id="@item.DocumentId"
                          method="post"
                          style="display:inline">

                        <button type="submit"
                                class="btn btn-danger btn-sm"
                                onclick="return confirm('Delete this document?');">
                            Delete
                        </button>

                    </form>

                </td>

            </tr>
        }

    </tbody>

</table>