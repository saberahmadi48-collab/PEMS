@model PEMS.Application.DTOs.EngineeringDocumentDto


@{
    ViewData["Title"] = "Engineering Document Details";


    string statusClass = Model.Status switch
    {
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        "Submitted" => "bg-warning text-dark",
        "Draft" => "bg-secondary",
        _ => "bg-primary"
    };
}



<h2>
    Engineering Document Details
</h2>

<hr />


<!-- STATUS -->

<div class="card mb-4">

<div class="card-header">
    Workflow Status
</div>


<div class="card-body">


<h5>
Current Status :

<span class="badge @statusClass">
    @Model.Status
</span>

</h5>


<hr />


@if(Model.Status == "Draft")
{

<form asp-action="Submit"
      method="post">

<input type="hidden"
       name="id"
       value="@Model.DocumentId" />


<button class="btn btn-warning">
Submit For Review
</button>


</form>

}



else if(Model.Status == "Submitted" ||
        Model.Status == "Review")
{


<form asp-action="Approve"
      method="post"
      class="d-inline">


<input type="hidden"
       name="id"
       value="@Model.DocumentId" />


<button class="btn btn-success">
Approve
</button>


</form>




<form asp-action="Reject"
      method="post"
      class="d-inline">


<input type="hidden"
       name="id"
       value="@Model.DocumentId" />


<button class="btn btn-danger">
Reject
</button>


</form>


}



else if(Model.Status == "Approved")
{


<form asp-action="CreateRevision"
      method="post">


<input type="hidden"
       name="id"
       value="@Model.DocumentId" />



<button class="btn btn-info">
Create New Revision
</button>


</form>


}



else if(Model.Status == "Rejected")
{


<form asp-action="Submit"
      method="post">


<input type="hidden"
       name="id"
       value="@Model.DocumentId" />


<button class="btn btn-warning">
Resubmit
</button>


</form>


}



</div>

</div>





<!-- BASIC INFORMATION -->


<h3>
Basic Information
</h3>


<table class="table table-bordered">


<tr>
<th>
Document No
</th>

<td>
@Model.DocumentNo
</td>

</tr>



<tr>
<th>
Title
</th>

<td>
@Model.Title
</td>

</tr>



<tr>
<th>
Description
</th>

<td>
@Model.Description
</td>

</tr>



<tr>
<th>
Document Type
</th>

<td>
@Model.DocumentType
</td>

</tr>



<tr>
<th>
Project
</th>

<td>
@Model.ProjectName
</td>

</tr>



<tr>
<th>
Discipline
</th>

<td>
@Model.DisciplineName
</td>

</tr>



<tr>
<th>
Revision
</th>

<td>
@Model.RevisionNo
</td>

</tr>



<tr>
<th>
Created Date
</th>

<td>
@Model.CreatedDate
</td>

</tr>


</table>







<!-- ENGINEERING INFORMATION -->


<h3>
Engineering Information
</h3>



<table class="table table-bordered">


<tr>

<th>
Issue Purpose
</th>


<td>
@Model.IssuePurpose
</td>


</tr>




<tr>

<th>
Prepared By
</th>


<td>
@Model.PreparedBy
</td>


</tr>




<tr>

<th>
Checked By
</th>


<td>
@Model.CheckedBy
</td>


</tr>




<tr>

<th>
Approved By
</th>


<td>
@Model.ApprovedBy
</td>


</tr>


</table>








<!-- ATTACHMENTS -->


<hr />

<h3>
Attachments
</h3>



<a asp-action="UploadAttachment"
   asp-route-id="@Model.DocumentId"
   class="btn btn-success mb-3">

Upload Attachment

</a>




@if(Model.Attachments != null &&
    Model.Attachments.Any())
{


<table class="table table-bordered">


<tr>

<th>
File Name
</th>


<th>
Extension
</th>


<th>
Size
</th>


<th>
AI Status
</th>


<th>
Date
</th>


<th>
Action
</th>


</tr>



@foreach(var file in Model.Attachments)
{


<tr>


<td>
@file.FileName
</td>



<td>
@file.FileExtension
</td>



<td>
@(file.FileSize / 1024) KB
</td>



<td>
@file.AIStatus
</td>



<td>
@file.UploadDate
</td>



<td>


<a asp-action="DownloadAttachment"
   asp-route-id="@file.AttachmentId"
   class="btn btn-sm btn-primary">

Download

</a>




<form asp-action="DeleteAttachment"
      asp-route-id="@file.AttachmentId"
      method="post"
      class="d-inline">


<button class="btn btn-sm btn-danger"
        onclick="return confirm('Delete file?')">

Delete

</button>


</form>


</td>



</tr>


}


</table>


}

else
{

<p>
No attachment available
</p>

}









<!-- REVISION HISTORY -->


<hr />

<h3>
Revision History
</h3>



@if(Model.Revisions != null &&
    Model.Revisions.Any())
{


<table class="table table-bordered">


<tr>

<th>
Revision
</th>


<th>
Status
</th>


<th>
Comment
</th>


<th>
Date
</th>


<th>
Prepared
</th>


<th>
Checked
</th>


<th>
Approved
</th>


</tr>



@foreach(var rev in Model.Revisions)
{


<tr>


<td>
@rev.RevisionNo
</td>


<td>
@rev.Status
</td>


<td>
@rev.Comment
</td>


<td>
@rev.RevisionDate
</td>


<td>
@rev.PreparedBy
</td>


<td>
@rev.CheckedBy
</td>


<td>
@rev.ApprovedBy
</td>


</tr>


}


</table>


}

else
{

<p>
No revision history
</p>

}









<!-- WORKFLOW HISTORY -->


<hr />

<h3>
Workflow History
</h3>



@if(Model.Workflows != null &&
    Model.Workflows.Any())
{


<table class="table table-striped">


<tr>

<th>
From
</th>


<th>
To
</th>


<th>
Action
</th>


<th>
Comment
</th>


<th>
Date
</th>


<th>
User
</th>


</tr>



@foreach(var item in Model.Workflows
.OrderByDescending(x=>x.ActionDate))
{


<tr>


<td>
@item.FromStatus
</td>


<td>
@item.ToStatus
</td>


<td>
@item.ActionType
</td>


<td>
@item.Comment
</td>


<td>
@item.ActionDate
</td>


<td>
@item.ActionBy
</td>


</tr>


}


</table>


}

else
{

<p>
No workflow history
</p>

}