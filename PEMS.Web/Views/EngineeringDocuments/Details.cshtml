<hr />

<h3>Attachments</h3>


@if(Model.Attachments != null && Model.Attachments.Any())
{
    <table class="table table-bordered">

        <tr>
            <th>File Name</th>
            <th>Type</th>
            <th>Upload Date</th>
            <th>AI Status</th>
            <th>Action</th>
        </tr>


        @foreach(var file in Model.Attachments)
        {
            <tr>

                <td>
                    @file.FileName
                </td>


                <td>
                    @file.FileExtension
                </td>


                <td>
                    @file.UploadDate
                </td>


                <td>
                    @file.AIStatus
                </td>


                <td>
                    <a href="@file.FilePath"
                       class="btn btn-sm btn-primary">
                        Open
                    </a>
                </td>

            </tr>
        }

    </table>
}
else
{
    <p>
        No attachment available
    </p>
}