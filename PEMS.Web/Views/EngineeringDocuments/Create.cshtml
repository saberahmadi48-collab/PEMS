@model PEMS.Domain.Entities.EngineeringDocument


<h2>Create Engineering Document</h2>


<form asp-action="Create" method="post">

    <div class="mb-3">
        <label>Document No</label>

        <input asp-for="DocumentNo"
               class="form-control" />
    </div>



    <div class="mb-3">
        <label>Title</label>

        <input asp-for="Title"
               class="form-control" />
    </div>



    <div class="mb-3">
        <label>Description</label>

        <textarea asp-for="Description"
                  class="form-control"></textarea>
    </div>



    <div class="mb-3">
        <label>Document Type</label>

        <select asp-for="DocumentType"
                class="form-control">

            <option value="">
                Select Type
            </option>

            <option value="Drawing">
                Drawing
            </option>

            <option value="Datasheet">
                Datasheet
            </option>

            <option value="Calculation">
                Calculation
            </option>

            <option value="Specification">
                Specification
            </option>

        </select>

    </div>



    <div class="mb-3">

        <label>Project</label>

        <select asp-for="ProjectId"
                asp-items="ViewBag.Projects"
                class="form-control">

            <option value="">
                Select Project
            </option>

        </select>

    </div>




    <div class="mb-3">

        <label>Discipline</label>

        <select asp-for="DisciplineId"
                asp-items="ViewBag.Disciplines"
                class="form-control">

            <option value="">
                Select Discipline
            </option>

        </select>

    </div>




    <div class="mb-3">

        <label>Status</label>

        <select asp-for="Status"
                class="form-control">

            <option value="Draft">
                Draft
            </option>

            <option value="Review">
                Review
            </option>

            <option value="Approved">
                Approved
            </option>

            <option value="Rejected">
                Rejected
            </option>

        </select>

    </div>




    <div class="mb-3">

        <label>Revision No</label>

        <input asp-for="RevisionNo"
               class="form-control" />

    </div>




    <button type="submit"
            class="btn btn-primary">

        Save

    </button>


    <a asp-action="Index"
       class="btn btn-secondary">

        Back

    </a>


</form>